{
	"name": "@rbxts/net",
	"version": "0.0.1",
	"description": "A Roblox logging library for TypeScript developers.",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"packageManager": "bun@1.3.1",
	"scripts": {
		"login": "bunx npm login --auth-type=legacy",
		"compile": "rm -rf ./out && rbxtsc -p ./src -i ./out/include",
		"watch": "rbxtsc -p ./src -i ./out/include -w"
	},
	"keywords": [
		"roblox-ts"
	],
	"author": "YOUR_NAME",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "YOUR_REPO_URL"
	},
	"bugs": {
		"url": "YOUR_REPO_URL_ISSUES"
	},
	"files": [
		"out",
		"!**/*.tsbuildinfo",
		"!**/*.spec.lua",
		"!**/*.spec.d.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@rbxts/lync": "github:Loner1536/lync#main",
		"@rbxts/object-utils": "^1.0.4",
		"@rbxts/pretty-react-hooks": "^0.6.4",
		"@rbxts/react": "^17.3.7-ts.1",
		"@rbxts/services": "^1.6.0",
		"@rbxts/set-timeout": "^1.1.2",
		"concurrently": "^9.2.1",
		"turbo": "^2.9.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.921",
		"chokidar-cli": "^3.0.0",
		"roblox-ts": "3.0.0",
		"typescript": "^5.9.3"
	}
}
