{
    "compilerOptions": {
        "target": "ESNext",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "noLib": true,
        "strict": true,
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment",
        "rootDir": "src",
        "outDir": "out",
        "moduleDetection": "force",
        "typeRoots": [
            "./node_modules/@rbxts"
        ],
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "downlevelIteration": true,
        "declaration": true,
        "paths": {
            "@api/*": [
                "./src/api/*"
            ],
            "@binary/*": [
                "./src/binary/*"
            ],
            "@codec/*": [
                "./src/codec/*"
            ],
            "@transport/*": [
                "./src/transport/*"
            ],
            "@security/*": [
                "./src/security/*"
            ],
            "@utility/*": [
                "./src/utility/*"
            ],
            "@constant": [
                "./src/constant"
            ],
            "@environment": [
                "./src/environment"
            ],
            "@type": [
                "./src/type"
            ]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "out"
    ]
}
